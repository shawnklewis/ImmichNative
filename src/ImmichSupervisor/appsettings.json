{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Information" }
  },
  "Supervisor": {
    "Root": "C:\\Users\\shawn\\source\\repos\\ImmichNative",
    "SecretsFile": "${root}\\run\\pg.env",
    "LogDirectory": "D:\\ImmichNative\\logs",
    "RestartInitialDelaySeconds": 2,
    "RestartMaxDelaySeconds": 120,
    "RestartResetAfterSeconds": 120,
    "Backup": {
      "Enabled": true,
      "TimeOfDay": "03:00",
      "Keep": 14,
      "Directory": "D:\\ImmichNative\\backups",
      "PgDump": "${root}\\tools\\pgsql\\bin\\pg_dump.exe",
      "PgRestore": "${root}\\tools\\pgsql\\bin\\pg_restore.exe",
      "Host": "127.0.0.1",
      "Port": 5433,
      "User": "postgres",
      "Database": "immich",
      "PasswordSecret": "PGPASSWORD"
    },
    "Components": [
      {
        "Name": "postgres",
        "Executable": "${root}\\tools\\pgsql\\bin\\postgres.exe",
        "Arguments": "-D D:\\ImmichNative\\pgdata -p 5433 -c listen_addresses=127.0.0.1",
        "Health": { "Type": "tcp", "Port": 5433, "StartupTimeoutSeconds": 120 },
        "Stop": {
          "Mode": "command",
          "Executable": "${root}\\tools\\pgsql\\bin\\pg_ctl.exe",
          "Arguments": "stop -D D:\\ImmichNative\\pgdata -m fast -w -t 90",
          "TimeoutSeconds": 120
        }
      },
      {
        "Name": "redis",
        "Executable": "${root}\\tools\\redis\\redis-server.exe",
        "Arguments": "\"${root}\\config\\redis.conf\"",
        "Health": { "Type": "tcp", "Port": 6380, "StartupTimeoutSeconds": 30 },
        "Stop": {
          "Mode": "command",
          "Executable": "${root}\\tools\\redis\\redis-cli.exe",
          "Arguments": "-p 6380 shutdown save",
          "TimeoutSeconds": 30
        }
      },
      {
        "Name": "immich-server",
        "Executable": "C:\\Program Files\\nodejs\\node.exe",
        "Arguments": "dist/main",
        "WorkingDirectory": "${root}\\vendor\\immich\\server",
        "DependsOn": [ "postgres", "redis" ],
        "Environment": {
          "NODE_ENV": "production",
          "PATH": "${root}\\tools\\ffmpeg;C:\\Program Files\\nodejs;C:\\Windows\\System32;C:\\Windows",
          "DB_HOSTNAME": "127.0.0.1",
          "DB_PORT": "5433",
          "DB_USERNAME": "postgres",
          "DB_PASSWORD": "${secret:PGPASSWORD}",
          "DB_DATABASE_NAME": "immich",
          "DB_VECTOR_EXTENSION": "pgvector",
          "REDIS_HOSTNAME": "127.0.0.1",
          "REDIS_PORT": "6380",
          "IMMICH_HOST": "127.0.0.1",
          "IMMICH_PORT": "2284",
          "IMMICH_MEDIA_LOCATION": "D:\\ImmichNative\\media",
          "IMMICH_BUILD_DATA": "D:\\ImmichNative\\build",
          "IMMICH_MACHINE_LEARNING_ENABLED": "false"
        },
        "Health": { "Type": "http", "Port": 2284, "Path": "/api/server/ping", "StartupTimeoutSeconds": 180 },
        "Stop": { "Mode": "kill", "TimeoutSeconds": 20 }
      }
    ]
  }
}
